        types.KeyboardButton('ℹ️ О службе'),
        types.KeyboardButton('📞 Контакты'),
        types.KeyboardButton('🎓 Учащимся'),
        types.KeyboardButton('👨‍👩‍👧 Родителям'),
        types.KeyboardButton('👩‍🏫 Педагогам'),
        types.KeyboardButton('🗺 Карта помощи'),
        types.KeyboardButton('❓ FAQ'),
        types.KeyboardButton('🆘 Помощь'),
    ]
    markup.add(*buttons)
    return markup

